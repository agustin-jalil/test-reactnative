import { useEffect } from 'react';
import {
  Dimensions,
  Modal,
  ScrollView,
  StyleSheet,
  Text,
  TouchableOpacity,
  TouchableWithoutFeedback,
  View,
} from 'react-native';
import Animated, {
  useAnimatedStyle,
  useSharedValue,
  withSpring,
  withTiming,
  Easing,
} from 'react-native-reanimated';
import { LinearGradient } from 'expo-linear-gradient';
import { Glass, H_PAD, Spacing } from '@/constants/theme';
import {
  AVAILABLE_APPS,
  CenterApp,
  useUiStore,
} from '@/stores/ui.store';

const { height: SCREEN_H } = Dimensions.get('window');

export function CenterAppPicker() {
  const { pickerVisible, setPickerVisible, centerApp, setCenterApp } = useUiStore();

  const translateY     = useSharedValue(SCREEN_H);
  const overlayOpacity = useSharedValue(0);

  useEffect(() => {
    if (pickerVisible) {
      overlayOpacity.value = withTiming(1, { duration: 240, easing: Easing.out(Easing.ease) });
      translateY.value     = withSpring(0, { damping: 22, stiffness: 260 });
    } else {
      overlayOpacity.value = withTiming(0, { duration: 200 });
      translateY.value     = withTiming(SCREEN_H, { duration: 260, easing: Easing.in(Easing.ease) });
    }
  }, [pickerVisible]);

  const overlayStyle = useAnimatedStyle(() => ({ opacity: overlayOpacity.value }));
  const sheetStyle   = useAnimatedStyle(() => ({ transform: [{ translateY: translateY.value }] }));

  function handleSelect(app: CenterApp) {
    setCenterApp(app);
    setPickerVisible(false);
  }

  function handleRemove() {
    setCenterApp(null);
    setPickerVisible(false);
  }

  return (
    <Modal
      visible={pickerVisible}
      transparent
      animationType="none"
      statusBarTranslucent
      onRequestClose={() => setPickerVisible(false)}>

      <TouchableWithoutFeedback onPress={() => setPickerVisible(false)}>
        <Animated.View style={[StyleSheet.absoluteFillObject, styles.overlay, overlayStyle]} />
      </TouchableWithoutFeedback>

      <Animated.View style={[styles.sheet, sheetStyle]}>
        {/* Handle */}
        <View style={styles.handleWrap}>
          <View style={styles.handle} />
        </View>

        <View style={styles.sheetHeader}>
          <View>
            <Text style={styles.sheetTitle}>Acceso rápido</Text>
            <Text style={styles.sheetSub}>
              {centerApp
                ? `Actual: ${centerApp.label} — toca para cambiar`
                : 'Elegí un módulo para el botón central'}
            </Text>
          </View>
          {centerApp && (
            <TouchableOpacity
              onPress={handleRemove}
              style={styles.removeBtn}
              accessibilityLabel="Quitar acceso rápido">
              <Text style={styles.removeTxt}>Quitar</Text>
            </TouchableOpacity>
          )}
        </View>

        <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={styles.gridContent}>
          <View style={styles.grid}>
            {AVAILABLE_APPS.map((app) => {
              const isSelected = centerApp?.id === app.id;
              return (
                <AppTile
                  key={app.id}
                  app={app}
                  isSelected={isSelected}
                  onPress={() => handleSelect(app)}
                />
              );
            })}
          </View>
        </ScrollView>

        <View style={styles.footer}>
          <Text style={styles.footerHint}>
            💡 Mantén presionado el botón central para volver a esta pantalla
          </Text>
        </View>
      </Animated.View>
    </Modal>
  );
}

// ── Tile individual ──────────────────────────────────────
function AppTile({
  app,
  isSelected,
  onPress,
}: {
  app: CenterApp;
  isSelected: boolean;
  onPress: () => void;
}) {
  const scale = useSharedValue(1);
  const anim  = useAnimatedStyle(() => ({ transform: [{ scale: scale.value }] }));

  function handlePress() {
    scale.value = withSpring(0.88, { duration: 80 }, () => {
      scale.value = withSpring(1, { duration: 200 });
    });
    onPress();
  }

  return (
    <TouchableOpacity
      onPress={handlePress}
      accessibilityLabel={`Seleccionar ${app.label}`}
      activeOpacity={0.8}
      style={styles.tile}>
      <Animated.View style={anim}>
        <LinearGradient
          colors={isSelected ? [app.color, app.colorTo] : ['rgba(255,255,255,0.08)', 'rgba(255,255,255,0.05)']}
          start={{ x: 0, y: 0 }} end={{ x: 1, y: 1 }}
          style={[styles.tileIcon, isSelected && styles.tileIconSelected]}>
          <Text style={[styles.tileIconTxt, isSelected && { color: '#fff' }]}>{app.icon}</Text>
        </LinearGradient>
        <Text style={[styles.tileLabel, isSelected && styles.tileLabelSelected]}>
          {app.label}
        </Text>
        {isSelected && <View style={styles.selectedDot} />}
      </Animated.View>
    </TouchableOpacity>
  );
}

